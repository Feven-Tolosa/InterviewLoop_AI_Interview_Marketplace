# ─── Stripe ────────────────────────────────────────────────────────────────
# Server-only secret key. Never expose this to the client.
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret from the Stripe dashboard (Dashboard → Developers →
# Webhooks) or from `stripe listen`. Required or the webhook returns 500.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Recurring monthly Price ids for the paid plans. Create them with:
#   npm run stripe:setup
NEXT_PUBLIC_STRIPE_PRICE_ID_STARTER=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=price_xxx

# Absolute app URL. Used as a fallback when the request has no origin header.
NEXT_PUBLIC_APP_URL=http://localhost:3000
